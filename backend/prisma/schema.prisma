generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Stage {
  PENDING
  ACCEPTED
  REJECTED
  IN_PROGRESS_SKETCH
  IN_PROGRESS_LINEART
  IN_PROGRESS_COLOR
  COMPLETED
  CANCELLED
}

enum PaymentState {
  PENDING
  DEPOSIT_PAID
  FULLY_PAID
}

model Artist {
  id           String       @id @default(uuid()) @db.Uuid
  email        String       @unique @db.VarChar(255)
  passwordHash String
  displayName  String       @db.VarChar(100)
  bio          String?
  slotsLimit   Int          @default(3)
  createdAt    DateTime     @default(now())
  services     Service[]
  commissions  Commission[]
}

model Service {
  id              String       @id @default(uuid()) @db.Uuid
  artistId        String       @db.Uuid
  title           String       @db.VarChar(100)
  description     String
  basePrice       Decimal      @db.Decimal(10, 2)
  estimatedDays   Int
  termsOfService  String
  isActive        Boolean      @default(true)
  artist          Artist       @relation(fields: [artistId], references: [id], onDelete: Cascade)
  commissions     Commission[]

  @@index([artistId, isActive])
}

model Commission {
  id             String        @id @default(uuid()) @db.Uuid
  publicTrackId  String        @unique @default(uuid()) @db.Uuid
  serviceId      String        @db.Uuid
  artistId       String        @db.Uuid
  clientName     String        @db.VarChar(100)
  clientEmail    String        @db.VarChar(255)
  details        String
  references     String[]
  stage          Stage          @default(PENDING)
  paymentStatus  PaymentState   @default(PENDING)
  finalFileUrl   String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  service        Service        @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  artist         Artist         @relation(fields: [artistId], references: [id], onDelete: Cascade)
  assets         CommissionAsset[]

  @@index([artistId, stage])
  @@index([clientEmail, stage])
}

model CommissionAsset {
  id           String     @id @default(uuid()) @db.Uuid
  commissionId String     @db.Uuid
  url          String
  mimeType     String
  sizeBytes    Int
  kind         String     @default("PROGRESS")
  createdAt    DateTime   @default(now())
  commission   Commission @relation(fields: [commissionId], references: [id], onDelete: Cascade)

  @@index([commissionId, createdAt])
}
