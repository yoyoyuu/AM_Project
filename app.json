{
  "expo": {
    "name": "AM_project",
    "slug": "AM_project",
    "version": "1.0.0",
    "scheme": "am-project",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.koma.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Koma necesita acceso a tu galería para que puedas adjuntar imágenes a tus comisiones.",
          "cameraPermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Koma necesita permiso para guardar la ilustración final en la galería de tu dispositivo.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "defaultChannel": "default"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "dd1bb5a3-18d6-459e-97ee-492e99e26bdc"
      }
    },
    "owner": "yoyoyuu"
  }
}
